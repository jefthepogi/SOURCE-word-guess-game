{
  "name": "source-word-guess-game",
  "productName": "DECODE SOURCE v2",
  "version": "1.0.0",
  "description": "Find The Source - a tech word guessing game",
  "author": "Dell",
  "main": "main.js",
  "scripts": {
    "install:python": "pip install -r tools/requirements.txt",
    "build:data": "python tools/build_wordbank.py",
    "start": "python -m http.server 8000",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.findthesource.game.v2",
    "productName": "DECODE SOURCE v2",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "src/**/*",
      "data/*.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
